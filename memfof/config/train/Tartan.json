{
    "name": "Tartan",
    "dataset": "TartanAir",
    "val_datasets": ["spring", "sintel", "kitti"],
    "monitor": null,

    "use_var": true,
    "var_min": 0,
    "var_max": 10,
    "pretrain": "resnet34",
    "radius": 4,
    "dim": 512,
    "num_blocks": 2,
    "iters": 4,

    "image_size": [480, 960],
    "scale": 1,
    "effective_batch_size": 64,
    "accumulate_grad_batches": 1,
    "num_workers": 16,
    "epsilon": 1e-8,
    "lr": 1.4e-4,
    "wdecay": 1e-5,
    "dropout": 0,
    "clip": 1.0,
    "gamma": 0.85,
    "num_steps": 225000,
    "val_steps": 15000,
    
    "restore_ckpt": null,
    "coarse_config": null
}